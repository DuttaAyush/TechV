# Client Configuration
# ======================
# Replace these values to customize the website for your client

# Full client/company name (appears in page titles, headers, etc.)
NEXT_PUBLIC_CLIENT_NAME=Your Company Name Technologies

# Short company name (appears in navigation, buttons, etc.)
NEXT_PUBLIC_CLIENT_SHORT_NAME=YourCompany

# Client website URL
NEXT_PUBLIC_CLIENT_URL=https://yourcompany.example.com

# Contact email
NEXT_PUBLIC_CLIENT_CONTACT_EMAIL=contact@yourcompany.example.com

# Social media handles
NEXT_PUBLIC_CLIENT_TWITTER=YourCompanyHandle
NEXT_PUBLIC_CLIENT_LINKEDIN=company/your-company-name

# Next.js Environment Variables
# =============================
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_CLIENT_URL}